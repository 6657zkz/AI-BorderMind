# 复制本文件为 backend/.env 并填入真实密钥
# LLM 抽象层读取：provider 决定用哪套 key / 端点

# 提供商：deepseek | qwen（百炼 DashScope，OpenAI 兼容端点）
LLM_PROVIDER=deepseek

# ---- DeepSeek ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ---- 通义千问（百炼 DashScope）----
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ---- 数据库（PostgreSQL + pgvector）----
DATABASE_URL=

# ---- 全局可选 ----
# LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=4096
# LLM_TIMEOUT=60
